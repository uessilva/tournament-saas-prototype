# Copy this file to .env before running the demo.
DATABASE_URL=postgres://summercup:summercup@localhost:5433/summercup
AUTH_SECRET=replace-with-a-long-random-development-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Mailpit SMTP
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM="Summer Cup <summercup@example.com>"

# Local storage for Scoresheet originals, previews, and crops.
STORAGE_DIR=.storage

# Development-only account switcher and protected reset controls.
DEMO_MODE=true
